# PeakGravity environment variables
# Copy this file to .env and fill in your values.
#
# Self-hosted Supabase: project Settings -> API
SUPABASE_PROJECT_ID=""
SUPABASE_URL=""
SUPABASE_PUBLISHABLE_KEY=""

# Same values for the renderer (Vite picks these up at build time).
# VITE_ prefixed variables get inlined into the client bundle.
VITE_SUPABASE_PROJECT_ID=""
VITE_SUPABASE_PUBLISHABLE_KEY=""
VITE_SUPABASE_URL=""

# 32-byte symmetric key used to encrypt provider API keys in the vault.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# DO NOT change this once you've saved keys, or existing ciphertexts become
# unrecoverable.
PROVIDER_KEY_ENCRYPTION_SECRET=""
